{
  "manifest_version": 3,
  "name": "Add to Twin Titans",
  "version": "1.0.0",
  "description": "Add an AliExpress product to your Twin Titans Emporium import queue in one click.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.aliexpress.com/*",
    "https://*.aliexpress.com/*",
    "https://twintitansemporium.store/*"
  ],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Add to Twin Titans", "default_popup": "options.html" },
  "content_scripts": [
    {
      "matches": ["https://*.aliexpress.com/item/*", "https://*.aliexpress.com/*/item/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
