# ---------------------------------------------------------------------------
# Twin Titans Commerce — environment
# Copy to .env.local for development, or set these in your host's dashboard.
# ---------------------------------------------------------------------------

# MySQL 8+. Works with PlanetScale, Railway, most cPanel shared hosting, or a
# plain self-hosted box. The database must be utf8mb4 so emoji and Chinese
# supplier text survive.
DATABASE_URL="mysql://user:password@localhost:3306/twintitans"

# Public origin of the store, no trailing slash. Used for callbacks + canonicals.
NEXT_PUBLIC_SITE_URL="http://localhost:3400"

# Signing key for admin sessions. Generate: openssl rand -base64 48
AUTH_SECRET=""

# --- Payments ---------------------------------------------------------------
# Paystack (NGN cards, bank transfer, USSD). Test keys start with sk_test_.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# PayPal (USD — PayPal cannot process NGN under any circumstance).
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox" # sandbox | live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# --- Supplier integrations (all optional) -----------------------------------
# Without these the importer falls back to public-page parsing, then to a
# manual paste form. Nothing hard-fails on a missing key.
ALIEXPRESS_APP_KEY=""
ALIEXPRESS_APP_SECRET=""
ALIEXPRESS_ACCESS_TOKEN=""

# Generic scraping gateway (ScraperAPI / ZenRows / Bright Data style).
# Set SCRAPER_ENDPOINT to a URL template containing {url}.
SCRAPER_ENDPOINT=""
SCRAPER_API_KEY=""

# --- Email (order confirmations / tracking) ---------------------------------
SMTP_URL=""
MAIL_FROM="Twin Titans Emporium <orders@example.com>"

# --- FX -------------------------------------------------------------------
# Optional live rate source; falls back to the FxRate table if unset.
FX_API_URL=""
