# Production build values. next build (NODE_ENV=production) loads this ahead of
# .env, so local `next dev` keeps using localhost while the shipped bundle gets
# the real origin.
#
# NEXT_PUBLIC_* is inlined at BUILD time, not read at runtime — setting this on
# the server does nothing. It must be correct when the build runs, or the
# storefront ships canonical=http://localhost:3400, checkout returns to
# localhost, and the capture bookmarklet posts to a machine that isn't there.
NEXT_PUBLIC_SITE_URL="https://twintitanemporium.com"
